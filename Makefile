# Top-level build entry point.
#
#   make                       download toolchains + Circle (first run) and build
#                              the kernel images of all targets
#   make TARGETS="rpi0w rpi4"  build only these targets
#   make VERSION=2026.11.0     set the firmware version (default: VERSION file,
#                              else "dev")
#   make sdcard                assemble build/sdcard/ and build/cm4-emmc/
#   make test                  build and run the host unit tests for src/core
#   make firmware-checksums    refresh scripts/firmware-files.txt after bumping
#                              a pinned firmware commit
#   make clean                 remove build outputs, keep toolchain/
#   make distclean             also remove toolchain/
#
# Targets: rpi0w (Zero W), rpi3 (Zero 2 W, Pi 3), rpi4 (Pi 4, CM4 Lite),
#          rpi4-emmc (CM4 with eMMC).

ROOT        := $(CURDIR)
ALL_TARGETS := rpi0w rpi3 rpi4 rpi4-emmc
TARGETS     ?= $(ALL_TARGETS)

# Firmware version: "make VERSION=x", else the VERSION file (release branches
# only), else "dev". A VERSION environment variable is deliberately ignored,
# because CI systems and shells often export one. The value ends up in a C
# string and in JSON, so only a safe character set is allowed.
ifneq ($(origin VERSION),command line)
override VERSION := $(strip $(shell cat VERSION 2>/dev/null))
endif
ifeq ($(VERSION),)
override VERSION := dev
endif
ifneq ($(shell printf '%s' '$(VERSION)' | grep -Eq '^[0-9A-Za-z._-]+$$' && echo ok),ok)
$(error invalid VERSION '$(VERSION)': only 0-9 A-Z a-z . _ - are allowed)
endif

VERSION_HEADER := build/generated/firmware_version.h

.PHONY: all bootstrap firmware version-header sdcard test firmware-checksums clean distclean

all: firmware

bootstrap:
	@./scripts/bootstrap.sh $(TARGETS)

# Rewritten only when the version changes, so that the dependency tracking of
# the firmware build rebuilds exactly the objects that include version.h.
version-header:
	@mkdir -p $(dir $(VERSION_HEADER))
	@printf '/* Generated by the top-level Makefile - do not edit. */\n#define RASPIR_FIRMWARE_VERSION "%s"\n' \
		'$(VERSION)' > $(VERSION_HEADER).tmp
	@if cmp -s $(VERSION_HEADER).tmp $(VERSION_HEADER); then \
		rm -f $(VERSION_HEADER).tmp; \
	else \
		mv $(VERSION_HEADER).tmp $(VERSION_HEADER); \
		echo "[firmware] version $(VERSION)"; \
		for dep in $$(grep -l firmware_version.h build/obj/*/*.d 2>/dev/null); do \
			rm -f "$${dep%.d}.o"; \
		done; \
		rm -f build/obj/*/kernel*.img build/obj/*/kernel*.elf; \
	fi
	@# macOS ships GNU make 3.81, which compares timestamps with one-second
	@# resolution: a version change within the same second as the previous
	@# build would go unnoticed. Deleting the dependent objects and the linked
	@# images makes the rebuild independent of timestamps.

firmware: bootstrap version-header
	@set -e; for target in $(TARGETS); do \
		echo "[firmware] building $$target"; \
		mkdir -p build/obj/$$target build/images/$$target; \
		$(MAKE) --no-print-directory -C build/obj/$$target -f $(ROOT)/src/fw/Makefile \
			SRCROOT=$(ROOT) CIRCLEHOME=$(ROOT)/toolchain/circle-$$target; \
		rm -f build/images/$$target/*.img; \
		cp build/obj/$$target/kernel*.img build/images/$$target/; \
	done

sdcard: firmware
	@./scripts/sdcard.sh

test:
	@$(MAKE) --no-print-directory -f tests/Makefile

firmware-checksums:
	@./scripts/firmware-checksums.sh

clean:
	rm -rf build
	@# Outputs of the former in-tree firmware build.
	rm -f src/fw/*.o src/fw/*.d src/fw/kernel*.img src/fw/kernel*.elf \
	      src/fw/kernel*.lst src/fw/kernel*.map

distclean: clean
	rm -rf toolchain
