# Copy this file to the root of the SD card as "raspir-blaster.conf"
# and adjust the values. Format: one key=value per line, "#" starts a comment.

# MQTT broker (required): IPv4 address or host name, max 63 characters.
# Host names are resolved through the router's DNS only: ".local" (mDNS)
# names such as homeassistant.local do not work, use the IP address.
mqtt_host=192.168.1.100

# MQTT broker port (optional, 1-65535, default 1883).
mqtt_port=1883

# MQTT credentials (optional, max 63 characters each).
# Leave mqtt_user unset for anonymous access; mqtt_password is ignored then.
#mqtt_user=mqtt_user
#mqtt_password=mqtt_password

# Device identifier (optional, 1-31 characters of a-z, 0-9 and -,
# default pi-zero-ir). Used as MQTT client id, DHCP/mDNS host name and for
# Home Assistant discovery. Must be unique per broker.
#device_id=pi-zero-ir

# Base MQTT topic (optional, 1-63 characters, no "+", "#" or trailing "/",
# default home/ir_blaster). Topics used: <topic_base>/send,
# <topic_base>/received and <topic_base>/status.
#topic_base=home/ir_blaster

# Silence in milliseconds that ends a received IR frame (optional, 5-60,
# default 15). Increase it if air-conditioner frames get split.
#ir_frame_gap_ms=15
