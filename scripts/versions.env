# Pinned third-party versions. Sourced by scripts/bootstrap.sh,
# scripts/sdcard.sh and scripts/firmware-checksums.sh.
# Changing a value here triggers a fresh download on the next build.

# ARM GNU Toolchains (bare-metal AArch32 and AArch64). Version recommended by
# the pinned Circle release. ARM publishes no Intel macOS build of it.
TOOLCHAIN_VERSION=15.2.rel1
TOOLCHAIN_HOST=darwin-arm64
TOOLCHAIN_URL_BASE=https://developer.arm.com/-/media/Files/downloads/gnu
TOOLCHAIN_SHA256_arm_none_eabi=1938a84b7105c192e3fb4fa5e893ba25f425f7ddab40515ae608cd40f68669a8
TOOLCHAIN_SHA256_aarch64_none_elf=37084c99bc05fda43a6c48900c638ae4fd6d93e2287ceb3e9bcda55437f1aadd

# Circle bare-metal framework.
CIRCLE_REPO=https://github.com/rsta2/circle.git
CIRCLE_TAG=Step51.1.1

# Raspberry Pi boot files (github.com/raspberrypi/firmware) and Wi-Fi firmware
# (github.com/RPi-Distro/firmware-nonfree), pinned to commits. The initial
# values are the revisions the pinned Circle release was tested with. The
# files and their SHA-256 checksums are listed in scripts/firmware-files.txt;
# after changing a commit, run "make firmware-checksums".
RPI_FIRMWARE_COMMIT=0641c5bf25d185d5bf25d8dcafd1da6dc8fdbf68
RPI_FIRMWARE_URL=https://github.com/raspberrypi/firmware/raw/${RPI_FIRMWARE_COMMIT}/boot
RPI_WIFI_FIRMWARE_COMMIT=c9d3ae6584ab79d19a4f94ccf701e888f9f87a53
RPI_WIFI_FIRMWARE_URL=https://github.com/RPi-Distro/firmware-nonfree/raw/${RPI_WIFI_FIRMWARE_COMMIT}/debian/config/brcm80211
